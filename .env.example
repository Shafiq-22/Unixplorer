# Copy to .env (gitignored) and adjust. Placeholders only.
DATABASE_URL=postgresql+psycopg://atlas:CHANGE_ME@localhost:5432/atlas
# Optional, for running the DB tests against a disposable database:
TEST_DATABASE_URL=postgresql+psycopg://atlas:CHANGE_ME@localhost:5432/atlas_test
# Used by docker-compose.yml
POSTGRES_USER=atlas
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=atlas
