{
  "name": "universe-atlas",
  "private": true,
  "packageManager": "pnpm@10.18.3",
  "scripts": {
    "dev": "pnpm --filter @atlas/web dev",
    "build": "pnpm --filter @atlas/web build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "gen:types": "pnpm --filter @atlas/shared-types generate",
    "test:e2e": "pnpm --filter @atlas/web test:e2e"
  }
}
